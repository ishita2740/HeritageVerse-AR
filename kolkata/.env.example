# Database
# Get DATABASE_URL from Neon integration in Vercel project settings
DATABASE_URL=postgresql://user:password@host/database

# AI & Generation
# Get a free API key from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Maps (Optional - using free Leaflet tiles by default, but you can add Mapbox token)
# NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Auth Session Secret (auto-generated, but include for reference)
BETTER_AUTH_SECRET=your_auth_secret_here
